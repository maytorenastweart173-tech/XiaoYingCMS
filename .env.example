# Django 核心配置
# SECRET_KEY 请在生产环境替换为随机长字符串：
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=False
ALLOWED_HOSTS=*

# 站点名称
SITE_NAME=小影CMS管理系统

# 版本
VERSION=2.0.0

# 小影 API 地址（仅用于蜘蛛 IP 验证等辅助能力，与 AI 生成无关）
API_URL=https://xiaoyingapi.com

# 备份目录（相对于项目根目录的路径，或绝对路径）
# 蜘蛛日志、操作日志等数据备份存放位置
BACKUP_DIR=backups
